{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-core/schemas/capability_matrix.schema.json",
  "title": "HARNESS Core Provider Capability Matrix",
  "type": "object",
  "required": ["version", "status", "policy", "providers"],
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string" },
    "policy": {
      "type": "object",
      "required": ["unverified_capabilities_must_not_be_true", "production_telemetry_default"],
      "properties": {
        "unverified_capabilities_must_not_be_true": { "const": true },
        "production_telemetry_default": { "const": false },
        "allowed_unverified_statuses": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "const": false }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "required": ["openai", "vllm", "ollama"],
      "additionalProperties": {
        "type": "object",
        "required": ["adapter_path", "status"],
        "properties": {
          "adapter_path": { "type": "string" },
          "status": { "enum": ["skeleton", "dry_run_checked", "provider_canary_blocked", "provider_canary_failed", "provider_canary_checked"] },
          "message_mapping": { "$ref": "#/$defs/feature_state" },
          "provider_canary": { "$ref": "#/$defs/canary_state" },
          "no_tool_text_path": { "$ref": "#/$defs/canary_state" },
          "no_tool_text_rerun": { "$ref": "#/$defs/canary_state" },
          "provider_trace": { "$ref": "#/$defs/canary_state" },
          "trace": { "$ref": "#/$defs/canary_state" },
          "redaction": { "$ref": "#/$defs/canary_state" },
          "structured_output_canary": { "$ref": "#/$defs/canary_state" },
          "structured_output_path": { "$ref": "#/$defs/canary_state" },
          "structured_output_rerun": { "$ref": "#/$defs/canary_state" },
          "json_schema_response_validation": { "$ref": "#/$defs/canary_state" },
          "tool_calling_canary": { "$ref": "#/$defs/canary_state" },
          "tool_call_path": { "$ref": "#/$defs/canary_state" },
          "tool_argument_schema_validation": { "$ref": "#/$defs/canary_state" },
          "mock_tool_output_reinjection": { "$ref": "#/$defs/canary_state" },
          "tool_output_reclassification": { "$ref": "#/$defs/canary_state" },
          "tool_calling_rerun": { "$ref": "#/$defs/canary_state" },
          "canary_replay_suite": { "$ref": "#/$defs/canary_state" },
          "replay_evidence": { "$ref": "#/$defs/canary_state" },
          "tool_calling": { "$ref": "#/$defs/feature_state" },
          "structured_outputs": { "$ref": "#/$defs/feature_state" },
          "evals_api": { "$ref": "#/$defs/feature_state" },
          "tracing": { "$ref": "#/$defs/feature_state" },
          "openai_compatible_server": { "$ref": "#/$defs/feature_state" },
          "chat_template": { "$ref": "#/$defs/feature_state" },
          "local_no_tool_canary": { "$ref": "#/$defs/canary_state" },
          "verified": { "const": false },
          "provider_execution": { "$ref": "#/$defs/provider_execution_state" },
          "local_model_execution": { "const": false },
          "runtime_execution": { "const": false },
          "telemetry": { "const": false },
          "redteam": { "const": false },
          "replay": { "const": false },
          "production_monitoring": { "const": false },
          "production_telemetry": { "const": false }
        },
        "additionalProperties": false
      }
    },
    "mock_runtime": {
      "type": "object",
      "required": [
        "runtime_orchestration",
        "tool_routing",
        "approval_boundary",
        "trace_schema",
        "provider_execution",
        "local_model_execution",
        "external_side_effects"
      ],
      "properties": {
        "runtime_orchestration": { "const": "beta_mock_executed" },
        "tool_routing": { "const": "mock_checked" },
        "approval_boundary": { "const": "smoke_tested" },
        "trace_schema": { "const": "smoke_tested" },
        "provider_execution": { "const": false },
        "local_model_execution": { "const": false },
        "external_side_effects": { "const": false }
      },
      "additionalProperties": false
    },
    "deferred_providers": {
      "type": "object",
      "additionalProperties": { "const": "roadmap" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "feature_state": {
      "enum": [false, "not_applicable", "needs_verification", "dry_run_checked", "canary_only"]
    },
    "canary_state": {
      "enum": [false, "needs_verification", "blocked", "blocked_by_missing_credential", "blocked_by_missing_model", "blocked_by_missing_local_endpoint", "blocked_trace_recorded", "canary_guard_checked", "canary_checked", "canary_rerun_checked", "canary_rerun_recorded", "canary_suite_checked", "canary_suite_recorded", "executed", "failed_http_429", "failed_trace_recorded", "failure_path_checked"]
    },
    "provider_execution_state": {
      "enum": [false, "blocked_by_missing_credential", "blocked_by_missing_model", "canary_failed", "canary_only"]
    }
  }
}

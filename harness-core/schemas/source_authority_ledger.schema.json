{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-core/schemas/source_authority_ledger.schema.json",
  "title": "HARNESS Core Source Authority Ledger",
  "type": "object",
  "required": [
    "generated_at",
    "validation_name",
    "claim_strength",
    "checked_on",
    "sources",
    "limitations"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "validation_name": {
      "const": "release_grade_source_authority_ledger"
    },
    "claim_strength": {
      "const": "official_source_ledger_static"
    },
    "checked_on": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "authority",
          "checked_on",
          "observed_last_updated",
          "supports",
          "applies_to",
          "claim_boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RGS-[A-Z0-9-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "checked_on": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          },
          "observed_last_updated": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

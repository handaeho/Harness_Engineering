{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-core/schemas/stack.schema.json",
  "title": "HARNESS Core Stack Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "agent_entrypoint",
    "source_of_truth",
    "asset_class_manifest",
    "reference_baseline",
    "dist_policy",
    "core",
    "adapters",
    "validation",
    "observability",
    "release",
    "allowed_claims"
  ],
  "properties": {
    "id": { "const": "harness-core" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["name", "slug", "legacy_names", "description"],
      "properties": {
        "name": { "const": "HARNESS Core" },
        "slug": { "const": "harness-core" },
        "legacy_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "const": "Evidence-gated autonomous agent engineering harness." }
      },
      "additionalProperties": false
    },
    "agent_entrypoint": {
      "type": "object",
      "required": ["path", "role"],
      "properties": {
        "path": { "const": "AGENTS.md" },
        "role": { "const": "agent_facing_system_of_record_index" }
      },
      "additionalProperties": false
    },
    "legacy_source_of_truth": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "core/spec/harness.spec.yaml" }
    },
    "source_of_truth": {
      "type": "object",
      "required": [
        "agent_index",
        "machine_manifest",
        "core_contract",
        "release_contract",
        "capability_contract",
        "evidence_truth"
      ],
      "properties": {
        "agent_index": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "AGENTS.md" }
        },
        "machine_manifest": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "stack.yaml" }
        },
        "core_contract": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "core/spec/harness.spec.yaml" }
        },
        "release_contract": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "release/gates/core-release/release_gate.yaml" }
        },
        "capability_contract": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "adapters/provider_capability_matrix.yaml" }
        },
        "evidence_truth": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "evidence/" }
        }
      },
      "additionalProperties": false
    },
    "asset_class_manifest": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "const": "MANIFEST.asset_classes.yaml" }
      },
      "additionalProperties": false
    },
    "reference_baseline": {
      "type": "object",
      "required": ["status", "role", "active_source_of_truth", "path", "mutation_policy"],
      "properties": {
        "status": { "const": "available" },
        "role": { "const": "historical_reference_snapshot" },
        "active_source_of_truth": { "const": false },
        "path": { "const": "evidence/reference-baseline" },
        "mutation_policy": { "const": "read_only" }
      },
      "additionalProperties": false
    },
    "dist_policy": {
      "type": "object",
      "required": ["path", "generated_only", "editable_by_human"],
      "properties": {
        "path": { "const": "dist" },
        "generated_only": { "const": true },
        "editable_by_human": { "const": false }
      },
      "additionalProperties": false
    },
    "core": { "type": "object" },
    "adapters": { "type": "object" },
    "validation": { "type": "object" },
    "observability": { "type": "object" },
    "release": { "type": "object" },
    "allowed_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

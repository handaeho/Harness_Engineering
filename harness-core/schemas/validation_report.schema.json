{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-core/schemas/validation_report.schema.json",
  "title": "HARNESS Core Dependency Validation Report",
  "type": "object",
  "required": [
    "status",
    "generated_at",
    "stage",
    "parser_status",
    "checks",
    "fallback_used",
    "runner_reexecution",
    "claims_allowed_after_pass",
    "claims_blocked"
  ],
  "properties": {
    "status": { "enum": ["pass", "fail"] },
    "generated_at": { "type": "string" },
    "stage": { "const": "v2.0.0-beta-preflight" },
    "parser_status": {
      "type": "object",
      "required": ["yaml", "json_schema"],
      "properties": {
        "yaml": {
          "type": "object",
          "required": ["parser", "external_parser_available", "fallback_used"],
          "properties": {
            "parser": { "type": "string" },
            "external_parser_available": { "const": true },
            "fallback_used": { "const": false }
          },
          "additionalProperties": true
        },
        "json_schema": {
          "type": "object",
          "required": ["validator", "external_validator_available", "fallback_used"],
          "properties": {
            "validator": { "type": "string" },
            "external_validator_available": { "const": true },
            "fallback_used": { "const": false }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "detail": {}
        },
        "additionalProperties": false
      }
    },
    "fallback_used": { "const": false },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "runner_reexecution": {
      "type": "object",
      "required": ["reference_baseline_runners_reexecuted", "provider_execution", "local_model_execution", "runtime_execution_loop_implemented", "live_telemetry_connected"],
      "properties": {
        "reference_baseline_runners_reexecuted": { "const": false },
        "provider_execution": { "const": false },
        "local_model_execution": { "const": false },
        "runtime_execution_loop_implemented": { "const": false },
        "live_telemetry_connected": { "const": false }
      },
      "additionalProperties": false
    },
    "claims_allowed_after_pass": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claims_blocked": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

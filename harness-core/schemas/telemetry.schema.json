{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-core/schemas/telemetry.schema.json",
  "title": "HARNESS Core Telemetry Schema Document",
  "type": "object",
  "required": ["run_id", "stack_version", "latency_ms", "input_tokens", "output_tokens", "eval_results"],
  "properties": {
    "run_id": { "type": "string" },
    "stack_version": { "type": "string" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "eval_results": { "type": "array" }
  },
  "additionalProperties": true
}

{
  "phase": "v2.0.0-alpha-hardening",
  "scanner": "tools/scan_prohibited_claims.mjs",
  "scan_root": "harness-core",
  "excluded_paths": [
    "evidence/v36-baseline",
    "node_modules",
    ".git"
  ],
  "prohibited_positive_claims": [
    "adapter-checked",
    "provider-verified",
    "runtime-verified",
    "tool-call-verified",
    "schema-output-verified",
    "telemetry-connected",
    "production-ready",
    "production-monitored",
    "containment-verified",
    "replay-verified",
    "benchmark-backed",
    "provider-diverse",
    "integration-verified",
    "release-gated"
  ],
  "allowed_contexts": [
    "blocked claim lists",
    "claim ladder definitions",
    "fixture claim_not_allowed fields",
    "claims_not_allowed fields",
    "forbidden_claims fields",
    "blocked_claims fields",
    "scanner configuration",
    "explicit statements that a claim is not allowed"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-core/runtime/run_request.schema.json",
  "title": "Mock Runtime Run Request",
  "type": "object",
  "required": ["run_id", "case_id", "input"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "requires_input": { "type": "boolean" },
        "mock_response_id": { "type": "string" },
        "tool_request": {
          "type": "object",
          "required": ["tool_name", "arguments"],
          "properties": {
            "tool_name": { "type": "string" },
            "arguments": { "type": "object" }
          },
          "additionalProperties": false
        },
        "context_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "content"],
            "properties": {
              "source_id": { "type": "string" },
              "source_type": { "type": "string" },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "expect_failure": { "type": "boolean" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-core/telemetry.schema.json",
  "title": "HARNESS Core Telemetry",
  "type": "object",
  "required": [
    "run_id",
    "stack_version",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "eval_results"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stack_version": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cost_estimate": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "stage": {
      "type": "string"
    },
    "adapter_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "suite_id": {
      "type": "string"
    },
    "estimated_cost": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "redaction_status": {
      "enum": ["pass", "fail", "not_applicable"]
    },
    "claim_level": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "otel_attributes": {
      "type": "object"
    },
    "langfuse_fields": {
      "type": "object"
    },
    "production_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "live_telemetry_connected": { "const": false },
        "telemetry_sink_write_enabled": { "const": false },
        "production_monitored_claim_allowed": { "const": false },
        "anomaly_thresholds_active": { "const": false }
      }
    },
    "eval_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suite_id", "status"],
        "properties": {
          "suite_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "partial", "not_run"]
          },
          "evidence_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

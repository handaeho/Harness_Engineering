{
  "name": "harness-core",
  "version": "2.0.0-beta-tool-calling-canary-openai",
  "private": true,
  "type": "module",
  "description": "Evidence-gated autonomous agent engineering harness.",
  "scripts": {
    "scan:claims": "node tools/scan_prohibited_claims.mjs",
    "check:reference-baseline": "node tools/check_reference_baseline_integrity.mjs",
    "validate:alpha": "node tools/validate_alpha.mjs",
    "validate:agents": "node tools/validate_agents_md_alignment.mjs",
    "check:sor": "node tools/check_system_of_record_alignment.mjs",
    "dry-run:adapters": "node tools/run_adapter_conformance_dry_run.mjs",
    "check:beta-entry": "node tools/check_beta_entry.mjs",
    "mock:runtime": "node tools/run_beta_mock_execution.mjs",
    "check:mock": "node tools/check_beta_mock_execution.mjs",
    "canary:openai": "node tools/run_openai_provider_canary.mjs",
    "check:openai-canary": "node tools/check_provider_canary_openai.mjs",
    "archive:openai-canary": "node tools/archive_provider_canary_attempt.mjs",
    "check:openai-credentialed-canary": "node tools/check_openai_credentialed_canary.mjs",
    "canary:openai-structured-output": "node tools/run_openai_structured_output_canary.mjs",
    "check:openai-structured-output": "node tools/check_openai_structured_output_canary.mjs",
    "canary:openai-tool-calling": "node tools/run_openai_tool_calling_canary.mjs",
    "check:openai-tool-calling": "node tools/check_openai_tool_calling_canary.mjs",
    "check:langfuse-tracing": "node tools/check_langfuse_tracing_integration.mjs",
    "local:readiness-preflight": "npm run local:qwen3-6-27b-readiness",
    "local:no-tool-canary": "npm run local:qwen3-6-27b-no-tool-canary",
    "local:qwen3-6-27b-readiness": "node tools/check_post_rc_local_endpoint_readiness_preflight.mjs --provider=ollama --endpoint-url=http://127.0.0.1:11434/v1 --model=qwen3.6:27b --operator-signal=ready --evidence-dir=post-rc-local-endpoint-readiness-preflight-qwen3-6-27b --report-prefix=post_rc_local_endpoint_readiness_preflight_qwen3_6_27b",
    "local:qwen3-6-27b-no-tool-canary": "node tools/run_local_no_tool_canary.mjs --provider=ollama --endpoint-url=http://127.0.0.1:11434/v1 --model=qwen3.6:27b --readiness-evidence-dir=post-rc-local-endpoint-readiness-preflight-qwen3-6-27b --evidence-dir=post-rc-local-no-tool-canary-qwen3-6-27b --report-prefix=post_rc_local_no_tool_canary_qwen3_6_27b",
    "local:qwen3-14b-review": "node tools/review_local_no_tool_canary_qwen3_14b.mjs && node tools/audit_local_no_tool_canary_qwen3_14b_claims.mjs && node tools/check_local_no_tool_canary_qwen3_14b_result_review.mjs",
    "local:qwen3-6-27b-review": "node tools/review_local_no_tool_canary_qwen3_6_27b.mjs && node tools/audit_local_no_tool_canary_qwen3_6_27b_claims.mjs && node tools/check_local_no_tool_canary_qwen3_6_27b_result_review.mjs",
    "preflight": "npm run check:reference-baseline && npm run dry-run:adapters && npm run validate:alpha && npm run scan:claims && npm run check:beta-entry",
    "mock-gate": "npm run check:reference-baseline && npm run dry-run:adapters && npm run mock:runtime && npm run validate:alpha && npm run scan:claims && npm run check:mock",
    "openai-canary-gate": "npm run check:reference-baseline && npm run dry-run:adapters && npm run mock:runtime && npm run canary:openai && npm run validate:alpha && npm run scan:claims && npm run check:openai-canary",
    "openai-credentialed-canary-gate": "npm run check:reference-baseline && npm run dry-run:adapters && npm run mock:runtime && npm run canary:openai && npm run validate:alpha && npm run scan:claims && npm run check:openai-credentialed-canary",
    "openai-structured-output-gate": "npm run check:reference-baseline && npm run dry-run:adapters && npm run mock:runtime && npm run canary:openai-structured-output && npm run validate:alpha && npm run scan:claims && npm run check:openai-structured-output",
    "openai-tool-calling-gate": "npm run check:reference-baseline && npm run dry-run:adapters && npm run mock:runtime && npm run canary:openai-tool-calling && npm run validate:alpha && npm run scan:claims && npm run check:openai-tool-calling"
  },
  "dependencies": {
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  }
}

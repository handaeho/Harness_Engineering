{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/prompt-stack-v2/runtime/failure_event.schema.json",
  "title": "Mock Runtime Failure Event",
  "type": "object",
  "required": ["run_id", "failure_class", "message", "recovery_applied"],
  "properties": {
    "run_id": { "type": "string" },
    "failure_class": { "enum": ["missing_required_input", "mock_model_failure", "tool_policy_block", "schema_contract"] },
    "message": { "type": "string" },
    "recovery_applied": { "type": "boolean" }
  },
  "additionalProperties": false
}

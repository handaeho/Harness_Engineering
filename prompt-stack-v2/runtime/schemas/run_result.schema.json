{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/prompt-stack-v2/runtime/run_result.schema.json",
  "title": "Mock Runtime Run Result",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "stage",
    "provider_execution",
    "local_model_execution",
    "external_side_effects",
    "trace_events",
    "state_transitions",
    "blocked_tools",
    "executed_mock_tools",
    "tool_outputs"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "status": { "enum": ["completed", "failed"] },
    "stage": { "const": "v2.0.0-beta-mock-execution" },
    "provider_execution": { "const": false },
    "local_model_execution": { "const": false },
    "external_side_effects": { "const": false },
    "final_output": {},
    "trace_events": {
      "type": "array",
      "items": { "type": "object" }
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_state", "to_state", "reason", "details"],
        "properties": {
          "from_state": { "type": "string" },
          "to_state": { "type": "string" },
          "reason": { "type": "string" },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "blocked_tools": { "type": "array", "items": { "type": "string" } },
    "executed_mock_tools": { "type": "array", "items": { "type": "string" } },
    "tool_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_name", "trust", "output"],
        "properties": {
          "tool_name": { "type": "string" },
          "trust": { "const": "untrusted_tool_output" },
          "output": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

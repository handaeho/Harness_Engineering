{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/prompt-stack-v2/runtime/context_packet.schema.json",
  "title": "Mock Runtime Context Packet",
  "type": "object",
  "required": ["run_id", "case_id", "sources", "source_quality", "missing_required_input"],
  "properties": {
    "run_id": { "type": "string" },
    "case_id": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "content", "trust"],
        "properties": {
          "source_id": { "type": "string" },
          "content": { "type": "string" },
          "trust": { "enum": ["fixture", "untrusted_tool_output"] }
        },
        "additionalProperties": false
      }
    },
    "source_quality": { "enum": ["fixture_only", "missing_required_input"] },
    "missing_required_input": { "type": "boolean" }
  },
  "additionalProperties": false
}

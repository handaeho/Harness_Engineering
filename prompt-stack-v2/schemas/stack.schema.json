{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/prompt-stack-v2/schemas/stack.schema.json",
  "title": "Prompt Stack v2 Stack Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "agent_entrypoint",
    "source_of_truth",
    "asset_class_manifest",
    "baseline",
    "dist_policy",
    "core",
    "adapters",
    "validation",
    "observability",
    "release",
    "allowed_claims"
  ],
  "properties": {
    "id": { "const": "prompt-stack-v2" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "agent_entrypoint": {
      "type": "object",
      "required": ["path", "role"],
      "properties": {
        "path": { "const": "AGENTS.md" },
        "role": { "const": "human_and_agent_facing_system_of_record_index" }
      },
      "additionalProperties": false
    },
    "legacy_source_of_truth": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "core/spec/harness.spec.yaml" }
    },
    "source_of_truth": {
      "type": "object",
      "required": [
        "agent_index",
        "machine_manifest",
        "core_contract",
        "release_contract",
        "capability_contract",
        "evidence_truth"
      ],
      "properties": {
        "agent_index": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "AGENTS.md" }
        },
        "machine_manifest": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "stack.yaml" }
        },
        "core_contract": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "core/spec/harness.spec.yaml" }
        },
        "release_contract": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "release/release_gate.yaml" }
        },
        "capability_contract": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "adapters/provider_capability_matrix.yaml" }
        },
        "evidence_truth": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "evidence/" }
        }
      },
      "additionalProperties": false
    },
    "asset_class_manifest": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "const": "MANIFEST.asset_classes.yaml" }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["source_package", "evidence_path", "mutation_policy"],
      "properties": {
        "source_package": { "const": "prompt-stack/v36" },
        "evidence_path": { "const": "evidence/v36-baseline" },
        "mutation_policy": { "const": "read_only" }
      },
      "additionalProperties": false
    },
    "dist_policy": {
      "type": "object",
      "required": ["path", "generated_only", "editable_by_human"],
      "properties": {
        "path": { "const": "dist" },
        "generated_only": { "const": true },
        "editable_by_human": { "const": false }
      },
      "additionalProperties": false
    },
    "core": { "type": "object" },
    "adapters": { "type": "object" },
    "validation": { "type": "object" },
    "observability": { "type": "object" },
    "release": { "type": "object" },
    "allowed_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

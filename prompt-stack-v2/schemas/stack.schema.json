{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/prompt-stack-v2/schemas/stack.schema.json",
  "title": "Prompt Stack v2 Stack Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "source_of_truth",
    "baseline",
    "dist_policy",
    "core",
    "adapters",
    "validation",
    "observability",
    "release",
    "allowed_claims"
  ],
  "properties": {
    "id": { "const": "prompt-stack-v2" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "source_of_truth": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "core/spec/harness.spec.yaml" }
    },
    "baseline": {
      "type": "object",
      "required": ["source_package", "evidence_path", "mutation_policy"],
      "properties": {
        "source_package": { "const": "prompt-stack/v36" },
        "evidence_path": { "const": "evidence/v36-baseline" },
        "mutation_policy": { "const": "read_only" }
      },
      "additionalProperties": false
    },
    "dist_policy": {
      "type": "object",
      "required": ["path", "generated_only", "editable_by_human"],
      "properties": {
        "path": { "const": "dist" },
        "generated_only": { "const": true },
        "editable_by_human": { "const": false }
      },
      "additionalProperties": false
    },
    "core": { "type": "object" },
    "adapters": { "type": "object" },
    "validation": { "type": "object" },
    "observability": { "type": "object" },
    "release": { "type": "object" },
    "allowed_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

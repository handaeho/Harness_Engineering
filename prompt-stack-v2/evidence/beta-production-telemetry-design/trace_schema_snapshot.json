{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/prompt-stack-v2/trace.schema.json",
  "title": "Prompt Stack v2 Trace Event",
  "type": "object",
  "required": [
    "run_id",
    "event_id",
    "event_type",
    "stage",
    "stack_version",
    "timestamp",
    "adapter_id",
    "provider_execution",
    "local_model_execution",
    "external_side_effect",
    "payload"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "enum": [
        "run_started",
        "context_built",
        "route_selected",
        "mock_model_called",
        "tool_requested",
        "approval_checked",
        "tool_blocked",
        "tool_executed_mock",
        "tool_output_reclassified_untrusted",
        "state_transition_recorded",
        "run_completed",
        "run_failed",
        "recovery_applied",
        "run_completed",
        "provider_request_sent",
        "provider_response_received",
        "provider_response_mapped",
        "structured_output_request_mapped",
        "schema_validation_completed",
        "tool_call_detected",
        "tool_arguments_validated",
        "tool_approval_checked",
        "mock_tool_executed",
        "tool_output_reclassified_untrusted",
        "final_response_received",
        "redteam_case_started",
        "redteam_case_evaluated",
        "redteam_case_failed",
        "redteam_case_passed",
        "release_gate_dry_run_started",
        "release_gate_blocked",
        "release_gate_completed",
        "approval_blocked",
        "prohibited_claim_detected",
        "redaction_failure_detected"
      ]
    },
    "stage": { "type": "string", "minLength": 1 },
    "stack_version": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "provider_execution": { "type": "boolean" },
    "local_model_execution": { "const": false },
    "external_side_effect": { "const": false },
    "payload": { "type": "object" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "surface": { "type": "string" },
    "case_id": { "type": "string" },
    "suite_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "span_id": { "type": "string" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "estimated_cost": { "type": ["number", "null"], "minimum": 0 },
    "redaction_status": { "enum": ["pass", "fail", "not_applicable"] },
    "payload_redacted": { "type": "boolean" },
    "raw_payload_stored": { "const": false },
    "otel_attributes": { "type": "object" },
    "langfuse_fields": { "type": "object" },
    "claim_level": { "type": "string" }
  },
  "additionalProperties": false
}

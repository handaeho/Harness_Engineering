{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v34 Harness Telemetry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "session_id",
    "run_id",
    "cohort_id",
    "scenario_id",
    "artifact_version",
    "selected_base_prompt",
    "started_at",
    "finished_at",
    "approval_events",
    "policy_decision_events",
    "network_policy_events",
    "tool_result_events",
    "retry_events",
    "failure_events",
    "verification_events"
  ],
  "properties": {
    "trace_id": { "type": "string" },
    "session_id": { "type": "string" },
    "run_id": { "type": "string" },
    "cohort_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "artifact_version": { "type": "string" },
    "prompt_version": { "type": "string" },
    "model_version": { "type": "string" },
    "selected_base_prompt": { "type": "string" },
    "selected_skill": { "type": "string" },
    "selected_overlays": { "type": "array", "items": { "type": "string" } },
    "example_mode": { "type": "string" },
    "task_family": { "type": "string" },
    "risk_class": { "type": "string" },
    "span_id": { "type": "string" },
    "parent_span_id": { "type": "string" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "approval_events": { "type": "array", "items": { "type": "object" } },
    "policy_decision_events": { "type": "array", "items": { "type": "object" } },
    "network_policy_events": { "type": "array", "items": { "type": "object" } },
    "tool_result_events": { "type": "array", "items": { "type": "object" } },
    "retry_events": { "type": "array", "items": { "type": "object" } },
    "failure_events": { "type": "array", "items": { "type": "object" } },
    "verification_events": { "type": "array", "items": { "type": "object" } },
    "safety_events": { "type": "array", "items": { "type": "object" } },
    "sandbox_events": { "type": "array", "items": { "type": "object" } },
    "memory_events": { "type": "array", "items": { "type": "object" } },
    "retrieval_events": { "type": "array", "items": { "type": "object" } },
    "multi_agent_events": { "type": "array", "items": { "type": "object" } },
    "error_events": { "type": "array", "items": { "type": "object" } },
    "worktree_id": { "type": "string" },
    "token_usage": { "type": "object", "additionalProperties": true },
    "claim_strength": { "type": "string" },
    "cost_events": { "type": "array", "items": { "type": "object" } },
    "latency_events": { "type": "array", "items": { "type": "object" } },
    "memory_operation_events": { "type": "array", "items": { "type": "object" } },
    "shell_command_events": { "type": "array", "items": { "type": "object" } },
    "log_query_events": { "type": "array", "items": { "type": "object" } },
    "metric_query_events": { "type": "array", "items": { "type": "object" } },
    "trace_query_events": { "type": "array", "items": { "type": "object" } },
    "dom_snapshot_events": { "type": "array", "items": { "type": "object" } },
    "screenshot_events": { "type": "array", "items": { "type": "object" } },
    "smoke_journey_events": { "type": "array", "items": { "type": "object" } },
    "final_state": { "type": "object", "additionalProperties": true },
    "verdict": { "type": "string" }
  }
}

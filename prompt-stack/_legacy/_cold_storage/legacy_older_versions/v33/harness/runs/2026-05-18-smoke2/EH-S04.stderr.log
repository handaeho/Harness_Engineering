  - `{verification_step_2}`
  - `{verification_step_3}`
- verification_pattern:
  - `criteria_visibility_check`
  - `loop_gain_check`
- risk_profile:
  - `medium`
- cost_profile_tags:
  - `reflection_heavy`
- anti_patterns:
